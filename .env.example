# Supabase Configuration
# Required: use the Project URL and publishable/anon key from Supabase.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# AI Provider Configuration (Optional)
VITE_AI_PROVIDER=fallback
VITE_AI_API_KEY=

# Ollama server configuration (server-side only; do not rename with a VITE_ prefix)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Application
VITE_APP_NAME=Trade Journal AI
